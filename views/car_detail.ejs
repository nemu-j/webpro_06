<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の詳細</h2>
  <table>
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= data.id %></td></tr>
    <tr><td>車名</td><td><%= data.name %></td></tr>
    <tr><td>メーカー</td><td><%= data.maker %></td></tr>
    <tr><td>メーカーの国</td><td><%= data.country %></td></tr>
    <tr><td>エンジン</td><td><%= data.engine %></td></tr>
    <tr><td>最高出力（PS）</td><td><%= data.power %></td></tr>
  </table>
  <a href="/car">車一覧に戻る</a>
</body>
</html>
