<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の詳細</h2>
  <table>
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= data.id %></td></tr>
    <tr><td>料理名</td><td><%= data.name %></td></tr>
    <tr><td>コース</td><td><%= data.course %></td></tr>
    <tr><td>主な食材</td><td><%= data.ingredient %></td></tr>
    <tr><td>価格（円）</td><td><%= data.price %></td></tr>
  </table>
  <a href="/french">メニュー一覧に戻る</a>
</body>
</html>
