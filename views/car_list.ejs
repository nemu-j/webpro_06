<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>スポーツカー一覧</title>
</head>
<body>
  <h2>スポーツカー一覧</h2>
  <table>
    <tr><th>ID</th><th>車名</th><th>メーカー</th></tr>
      <% let number = 0 %>
      <% for( let row of data ) { %>
        <tr><td><%= row.id %></td><td><a href="/car/<%= number %>"><%= row.name %></a></td><td><%= row.maker %></td></tr>
        <% number += 1 %>
      <% } %>
  </table>
  <a href="/public/car_add.html">追加する</a>
</body>
</html>
